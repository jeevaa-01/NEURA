// NEURA — database schema
//
// Phase 2: the core collaboration domain (users, workspaces, channels,
// conversations, messages, reactions, mentions, notifications, invites and
// attachments).
//
// Conventions used throughout this file:
//
//   * Primary keys are UUIDv7 (`@db.Uuid`). v7 is time-ordered, so inserts land
//     at the right edge of the B-tree instead of scattering across it — this
//     matters most on `messages`, the highest-write table in the system.
//   * Every timestamp is `timestamptz` so values are unambiguously UTC.
//   * Tables and columns are snake_case; Prisma models stay PascalCase.
//   * Case-insensitive identity columns (email, username, slugs) use `citext`
//     so uniqueness is enforced by the database rather than by convention.
//
// Full rationale, diagrams and index reasoning: docs/database-architecture.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

/// Coarse-grained workspace authority. See "Future permission extension
/// strategy" in docs/database-architecture.md before adding values here.
enum WorkspaceRoleType {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  GUEST

  @@map("workspace_role_type")
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE

  @@map("channel_type")
}

enum ConversationType {
  DIRECT
  GROUP

  @@map("conversation_type")
}

/// Membership lifecycle. `LEFT` is retained rather than deleted so that a
/// user's historical messages keep a resolvable membership record.
enum MemberStatus {
  ACTIVE
  SUSPENDED
  LEFT

  @@map("member_status")
}

enum NotificationType {
  MESSAGE
  MENTION
  REACTION
  REPLY
  SYSTEM
  MESSAGE_MENTION
  THREAD_REPLY
  CHANNEL_INVITATION
  WORKSPACE_INVITATION
  TASK_ASSIGNED
  TASK_UPDATED
  AI_ACTION_COMPLETED
  AI_ACTION_FAILED
  WORKFLOW_COMPLETED
  WORKFLOW_FAILED
  KNOWLEDGE_INDEXED
  KNOWLEDGE_INDEX_FAILED

  @@map("notification_type")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invite_status")
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL

  @@map("ai_message_role")
}

enum KnowledgeSourceType {
  MANUAL_TEXT
  FILE_UPLOAD

  @@map("knowledge_source_type")
}

enum AttachmentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETED

  @@map("attachment_status")
}

enum KnowledgeIndexStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING

  @@map("knowledge_index_status")
}

enum AIActionStatus {
  PROPOSED
  AWAITING_CONFIRMATION
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED

  @@map("ai_action_status")
}

enum AIActionRisk {
  SAFE_READ
  LOW_WRITE
  EXTERNAL_WRITE
  DESTRUCTIVE

  @@map("ai_action_risk")
}

enum TaskStatus {
  OPEN
  DONE

  @@map("task_status")
}

enum WorkflowStatus {
  DRAFT
  READY
  DISABLED

  @@map("workflow_status")
}

enum WorkflowTriggerType {
  MANUAL
  AI_REQUEST

  @@map("workflow_trigger_type")
}

enum WorkflowExecutionStatus {
  READY
  RUNNING
  WAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED

  @@map("workflow_execution_status")
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  WAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED

  @@map("workflow_step_status")
}

// ===========================================================================
// Identity
// ===========================================================================

/// A person on the platform.
///
/// Credentials live in `Account`, never here — see the Authentication section
/// at the end of this file. `isActive` exists so that deactivation never
/// requires deleting a user: authorship of durable content is protected by
/// `Restrict` foreign keys, so a hard delete would be blocked by the database
/// anyway.
///
/// Better Auth (Phase 3) reads this model through field mappings rather than
/// columns of its own — its logical `name` is NEURA's `displayName` and its
/// `image` is `avatarUrl`. `emailVerified` is the single column Better Auth
/// required that NEURA did not already have. See docs/authentication.md.
model User {
  id          String  @id @default(uuid(7)) @db.Uuid
  email       String  @unique @db.Citext
  username    String  @unique @db.Citext
  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String?
  statusText  String? @map("status_text")
  isActive    Boolean @default(true) @map("is_active")

  /// Required by Better Auth. Verification *delivery* is not implemented yet,
  /// so this stays false until the email phase turns it on.
  emailVerified Boolean @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  ownedWorkspaces         Workspace[]
  workspaceMemberships    WorkspaceMember[]
  createdChannels         Channel[]
  channelMemberships      ChannelMember[]
  createdConversations    Conversation[]
  conversationMemberships ConversationMember[]
  sentMessages            Message[]
  reactions               MessageReaction[]
  mentions                MessageMention[]
  sentInvites             WorkspaceInvite[]
  receivedNotifications   Notification[]       @relation("NotificationRecipient")
  performedNotifications  Notification[]       @relation("NotificationActor")
  notificationPreference  NotificationPreference?
  activityEvents           ActivityEvent[]      @relation("ActivityActor")
  aiConversations         AIConversation[]
  aiUsage                 AIUsage[]
  aiAuditLogs             AIAuditLog[]
  knowledgeSources        KnowledgeSource[] @relation("KnowledgeSourceCreator")
  createdTasks             WorkspaceTask[] @relation("TaskCreator")
  assignedTasks            WorkspaceTask[] @relation("TaskAssignee")
  uploadedAttachments      Attachment[] @relation("AttachmentUploader")
  aiActions                AIAction[]
  createdWorkflows         Workflow[] @relation("WorkflowCreator")
  workflowExecutions       WorkflowExecution[] @relation("WorkflowInitiator")

  // Chronological listings for administration and analytics. `email` and
  // `username` already carry unique indexes and need no separate entry.
  @@index([createdAt])
  @@map("users")
}

// ===========================================================================
// Workspaces
// ===========================================================================

/// The top-level tenant boundary. Channels, invites and workspace-scoped
/// conversations all hang off a workspace.
model Workspace {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String  @unique @db.Citext
  description String?
  iconUrl     String? @map("icon_url")
  ownerId     String  @map("owner_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members       WorkspaceMember[]
  channels      Channel[]
  conversations Conversation[]
  invites       WorkspaceInvite[]
  notifications Notification[]
  aiConversations AIConversation[]
  aiUsage        AIUsage[]
  aiAuditLogs    AIAuditLog[]
  knowledgeSources KnowledgeSource[]
  attachments     Attachment[]
  tasks           WorkspaceTask[]
  activities      ActivityEvent[]
  aiActions       AIAction[]
  workflows       Workflow[]
  workflowExecutions WorkflowExecution[]

  // "Workspaces owned by this user", and an index for the FK so that owner
  // lookups do not degrade into sequential scans.
  @@index([ownerId])
  @@map("workspaces")
}

/// Join record between a user and a workspace, carrying the user's role and
/// membership state within that tenant.
model WorkspaceMember {
  id          String            @id @default(uuid(7)) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        WorkspaceRoleType @default(MEMBER)
  status      MemberStatus      @default(ACTIVE)
  nickname    String?
  joinedAt    DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per workspace. This unique index doubles as the
  // access-control lookup (workspaceId, userId) and, via its leading column, as
  // the "list the members of this workspace" index — no separate index needed.
  @@unique([workspaceId, userId])
  // "Which workspaces does this user belong to?" — the reverse direction, which
  // the composite above cannot serve.
  @@index([userId])
  @@map("workspace_members")
}

// ===========================================================================
// Channels
// ===========================================================================

/// A durable, workspace-scoped room. `isPrivate` decides whether membership in
/// `ChannelMember` is required to read it.
model Channel {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  slug        String      @db.Citext
  description String?
  type        ChannelType @default(TEXT)
  isPrivate   Boolean     @default(false) @map("is_private")
  /// System channels are created with the workspace and cannot be deleted or archived.
  isSystem    Boolean     @default(false) @map("is_system")
  /// NULL means active. Archived channels remain recoverable for authorized admins.
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(3)
  /// Manual ordering within the workspace sidebar.
  position    Int         @default(0)
  createdById String      @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members   ChannelMember[]
  messages  Message[]
  aiConversations AIConversation[]
  knowledgeSources KnowledgeSource[]
  attachments Attachment[]
  notifications Notification[]
  activities ActivityEvent[]

  // Channel slugs are unique per workspace, not globally.
  @@unique([workspaceId, slug])
  // Sidebar rendering: every channel of a workspace in display order.
  @@index([workspaceId, position])
  // Accessible channel listings filter by lifecycle and visibility.
  @@index([workspaceId, isPrivate, archivedAt, position])
  // Chronological listing (recently created channels, admin views).
  @@index([workspaceId, createdAt])
  // FK index for "channels created by this user".
  @@index([createdById])
  @@map("channels")
}

/// Explicit channel membership.
///
/// Required for private channels, and the home of per-user read state
/// (`lastReadAt`) that unread badges will read in a later phase.
model ChannelMember {
  id         String    @id @default(uuid(7)) @db.Uuid
  channelId  String    @map("channel_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per channel; the leading column also serves
  // "list the members of this channel".
  @@unique([channelId, userId])
  // "Which private channels can this user see?"
  @@index([userId])
  @@map("channel_members")
}

// ===========================================================================
// Conversations (direct and group messaging)
// ===========================================================================

/// A direct or small-group conversation.
///
/// `workspaceId` is optional so conversations can exist either inside a
/// workspace or across the platform.
model Conversation {
  id          String           @id @default(uuid(7)) @db.Uuid
  type        ConversationType
  workspaceId String?          @map("workspace_id") @db.Uuid
  name        String?
  createdById String           @map("created_by_id") @db.Uuid

  /// Canonical identity of a DIRECT conversation: the two participant UUIDs
  /// sorted ascending and joined with ":". Populated by the application for
  /// DIRECT rows and left NULL for GROUP rows — PostgreSQL permits unlimited
  /// NULLs in a unique index, so this gives a database-level guarantee that a
  /// pair of users can never end up with two DM threads, without a trigger.
  directKey String? @unique @map("direct_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members   ConversationMember[]
  messages  Message[]

  // Workspace-scoped conversation listings.
  @@index([workspaceId])
  // FK index for "conversations started by this user".
  @@index([createdById])
  @@map("conversations")
}

/// Participant in a conversation, with per-user read state.
model ConversationMember {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per conversation. The leading column also answers
  // "who is in this conversation?", so no separate conversationId index exists.
  @@unique([conversationId, userId])
  // "List this user's conversations" — the inbox query.
  @@index([userId])
  @@map("conversation_members")
}

// ===========================================================================
// Messages
// ===========================================================================

/// A single message, in either a channel or a conversation — never both.
///
/// One table serves both containers so that replies, reactions, mentions,
/// attachments, notifications and search each need exactly one foreign key
/// instead of two parallel sets. The XOR between `channel_id` and
/// `conversation_id` is enforced by a database CHECK constraint added in the
/// migration, because Prisma's schema language cannot express CHECK.
///
/// Deletion is soft: `isDeleted` / `deletedAt` are set and the row stays, so
/// thread structure and reply counts survive.
model Message {
  id             String  @id @default(uuid(7)) @db.Uuid
  content        String
  authorId       String  @map("author_id") @db.Uuid
  channelId      String? @map("channel_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  /// Thread root. NULL for a top-level message.
  parentId       String? @map("parent_id") @db.Uuid

  isEdited  Boolean   @default(false) @map("is_edited")
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       Message?      @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Message[]     @relation("MessageThread")

  reactions     MessageReaction[]
  mentions      MessageMention[]
  attachments   Attachment[]
  notifications Notification[]

  // Cursor pagination over a channel: seek on (created_at, id) so that messages
  // sharing a timestamp still have a total order and no row is skipped or
  // repeated. `id` is UUIDv7, so it breaks ties in insertion order.
  @@index([channelId, createdAt, id])
  // The same access path for direct and group conversations.
  @@index([conversationId, createdAt, id])
  // "Everything this user wrote, newest first" — profile views and moderation.
  @@index([authorId, createdAt])
  // Thread expansion: a root's replies in order. Also the FK index that keeps
  // cascading deletes of a thread root cheap.
  @@index([parentId, createdAt])
  @@map("messages")
}

/// An emoji reaction. One row per (message, user, emoji).
model MessageReaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user may react once per emoji per message. The leading column also serves
  // "load all reactions for this message", so no separate messageId index.
  @@unique([messageId, userId, emoji])
  // FK index for cascade cleanup when a user is removed.
  @@index([userId])
  @@map("message_reactions")
}

/// A user referenced inside a message. Extracted at write time so the mention
/// inbox never has to scan message bodies.
model MessageMention {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One mention row per user per message; the leading column also answers
  // "who is mentioned in this message?".
  @@unique([messageId, userId])
  // "Messages that mention me, newest first."
  @@index([userId, createdAt])
  @@map("message_mentions")
}

// ===========================================================================
// AI conversations
// ===========================================================================

/// A private AI conversation owned by one user inside one workspace.
/// Channel context is optional and is always re-authorized before retrieval.
model AIConversation {
  id          String  @id @default(uuid(7)) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  channelId   String? @map("channel_id") @db.Uuid
  title       String  @default("New conversation")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel   Channel?        @relation(fields: [channelId], references: [id], onDelete: SetNull)
  messages  AIMessage[]
  usage     AIUsage[]
  auditLogs AIAuditLog[]
  actions   AIAction[]
  workflowExecutions WorkflowExecution[]

  @@index([workspaceId, userId, updatedAt])
  @@index([userId, updatedAt])
  @@index([channelId, updatedAt])
  @@map("ai_conversations")
}

/// Persisted user/assistant turns. Tool output is retained only for provider
/// continuation and is not exposed by the normal conversation UI.
model AIMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AIMessageRole
  content        String
  citations      Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("ai_messages")
}

/// Provider-reported usage, when available. Cost is intentionally omitted
/// until pricing is configured and reliable for the selected model.
model AIUsage {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  provider       String
  model          String
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  totalTokens    Int?      @map("total_tokens")
  status         String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_usage")
}

/// Small, content-minimized audit entries for AI requests and tool execution.
model AIAuditLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  action         String
  status         String
  toolName       String?   @map("tool_name")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_audit_logs")
}

/// A server-owned, idempotent action proposal. Payloads are validated tool
/// inputs; identity and workspace scope are always derived from the session.
model AIAction {
  id              String         @id @default(uuid(7)) @db.Uuid
  conversationId  String?        @map("conversation_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  toolName        String         @map("tool_name")
  risk            AIActionRisk
  status          AIActionStatus @default(PROPOSED)
  requiresConfirmation Boolean    @default(true) @map("requires_confirmation")
  inputPayload    Json           @map("input_payload")
  displaySummary  String         @map("display_summary")
  resultMetadata  Json?          @map("result_metadata")
  errorMetadata   Json?          @map("error_metadata")
  idempotencyKey  String         @unique @map("idempotency_key")
  confirmationAt  DateTime?      @map("confirmation_at") @db.Timestamptz(3)
  executionStartedAt DateTime?   @map("execution_started_at") @db.Timestamptz(3)
  executedAt      DateTime?      @map("executed_at") @db.Timestamptz(3)
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowStep WorkflowStepExecution?

  @@index([workspaceId, userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([workspaceId, status, expiresAt])
  @@map("ai_actions")
}

/// Minimal task foundation used by the explicit create_task action. It is
/// deliberately not an automation scheduler or background queue.
model WorkspaceTask {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  createdById String     @map("created_by_id") @db.Uuid
  assigneeId  String?    @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  dueAt       DateTime?  @map("due_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([assigneeId, status, updatedAt])
  @@map("workspace_tasks")
}

// ===========================================================================
// Agent and workflow execution
// ===========================================================================

/// A small structured workflow definition. Configuration is validated against
/// the server-side AI tool registry before it is stored.
model Workflow {
  id          String              @id @default(uuid(7)) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  createdById String              @map("created_by_id") @db.Uuid
  name        String
  description String?
  status      WorkflowStatus      @default(READY)
  trigger     WorkflowTriggerType @default(MANUAL)
  configuration Json
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: Restrict)
  executions WorkflowExecution[]

  @@index([workspaceId, status, updatedAt])
  @@index([createdById, updatedAt])
  @@map("workflows")
}

/// One bounded run of a workflow. The workflow definition is re-read and
/// authorization is re-checked for every step.
model WorkflowExecution {
  id              String                 @id @default(uuid(7)) @db.Uuid
  workflowId      String                 @map("workflow_id") @db.Uuid
  conversationId  String?                @map("conversation_id") @db.Uuid
  initiatedById   String                 @map("initiated_by_id") @db.Uuid
  workspaceId     String                 @map("workspace_id") @db.Uuid
  status          WorkflowExecutionStatus @default(READY)
  currentStep     Int                    @default(0) @map("current_step")
  failureMessage  String?                @map("failure_message")
  resultSummary   String?                @map("result_summary")
  startedAt       DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  initiatedBy  User            @relation("WorkflowInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps        WorkflowStepExecution[]

  @@index([workflowId, createdAt])
  @@index([workspaceId, initiatedById, createdAt])
  @@index([workspaceId, status, updatedAt])
  @@map("workflow_executions")
}

/// Persisted result for one sequential workflow step. The step id is the
/// stable idempotency boundary for retries and duplicate execution requests.
model WorkflowStepExecution {
  id            String             @id @default(uuid(7)) @db.Uuid
  executionId   String             @map("execution_id") @db.Uuid
  stepIndex     Int                @map("step_index")
  toolName      String             @map("tool_name")
  inputPayload  Json               @map("input_payload")
  confirmationRequired Boolean      @default(false) @map("confirmation_required")
  status        WorkflowStepStatus @default(PENDING)
  resultSummary String?            @map("result_summary")
  resultPayload Json?              @map("result_payload")
  errorMessage  String?            @map("error_message")
  aiActionId    String?            @unique @map("ai_action_id") @db.Uuid
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  aiAction  AIAction?         @relation(fields: [aiActionId], references: [id], onDelete: SetNull)

  @@unique([executionId, stepIndex])
  @@index([executionId, status, stepIndex])
  @@map("workflow_step_executions")
}

// ===========================================================================
// Knowledge and RAG
// ===========================================================================

/// An explicitly-created text knowledge source. Binary uploads are not part of
/// the current storage boundary, so raw manual text is retained in its
/// document for deterministic retry/re-index operations.
model KnowledgeSource {
  id          String               @id @default(uuid(7)) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  channelId   String?              @map("channel_id") @db.Uuid
  createdById String               @map("created_by_id") @db.Uuid
  attachmentId String?            @unique @map("attachment_id") @db.Uuid
  type        KnowledgeSourceType
  name        String
  status      KnowledgeIndexStatus  @default(PENDING)
  errorMessage String?             @map("error_message")
  lastIndexedAt DateTime?          @map("last_indexed_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User             @relation("KnowledgeSourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  document  KnowledgeDocument?
  attachment Attachment?          @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, channelId, status])
  @@index([createdById, createdAt])
  @@map("knowledge_sources")
}

/// Logical text document behind a source. `content` is bounded normalized
/// text, not an executable file or path.
model KnowledgeDocument {
  id          String               @id @default(uuid(7)) @db.Uuid
  sourceId    String               @unique @map("source_id") @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  channelId   String?              @map("channel_id") @db.Uuid
  title       String
  mimeType    String               @map("mime_type")
  content     String
  checksum    String
  status      KnowledgeIndexStatus @default(PENDING)
  errorMessage String?             @map("error_message")
  chunkCount  Int                  @default(0) @map("chunk_count")
  lastIndexedAt DateTime?          @map("last_indexed_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, channelId, status])
  @@index([checksum])
  @@map("knowledge_documents")
}

/// A bounded searchable unit. Embeddings use JSON until the deployed
/// PostgreSQL image provides pgvector; VectorStore is the replacement seam.
model KnowledgeChunk {
  id            String   @id @default(uuid(7)) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  channelId     String?  @map("channel_id") @db.Uuid
  content       String
  chunkIndex    Int      @map("chunk_index")
  characterCount Int     @map("character_count")
  tokenCount    Int?     @map("token_count")
  metadata      Json?
  embedding     Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([workspaceId, channelId, documentId])
  @@index([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

// ===========================================================================
// Notifications
// ===========================================================================

/// A delivered notification. Read state is soft (`isRead` / `readAt`) so the
/// row survives for history and analytics.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  messageId   String?          @map("message_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  channelId   String?          @map("channel_id") @db.Uuid
  resourceId  String?          @map("resource_id") @db.Uuid
  /// Who caused it. NULL for SYSTEM notifications.
  actorId     String?          @map("actor_id") @db.Uuid
  title       String
  body        String
  metadata    Json?
  targetPath  String?          @map("target_path")
  dedupKey    String?          @unique @map("dedup_key")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  message   Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // The unread badge and the unread feed. `is_read` sits in the middle so the
  // index can filter on it and still return rows already ordered by created_at.
  @@index([userId, isRead, createdAt])
  // The full notification history, newest first. Not redundant with the index
  // above: that one cannot produce a created_at ordering that spans both
  // is_read values without a sort.
  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([channelId, createdAt])
  @@map("notifications")
}

/// Per-user in-app notification controls. Missing rows use the default true
/// policy; invitation notifications are always delivered.
model NotificationPreference {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  mentions        Boolean  @default(true)
  threadReplies   Boolean  @default(true) @map("thread_replies")
  reactions       Boolean  @default(true)
  taskAssignments Boolean  @default(true) @map("task_assignments")
  aiActions       Boolean  @default(true) @map("ai_actions")
  workflows       Boolean  @default(true)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// User-facing workspace history. Security audits remain in AIAuditLog and
/// are intentionally not duplicated here.
model ActivityEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  channelId   String?  @map("channel_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  resourceId  String?  @map("resource_id") @db.Uuid
  type        String
  title       String
  body        String
  metadata    Json?
  dedupKey    String?  @unique @map("dedup_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([channelId, createdAt])
  @@map("activity_events")
}

// ===========================================================================
// Invites
// ===========================================================================

/// A workspace invitation, either addressed to an email or usable as a
/// shareable link. Expiry is stored but evaluated by the application.
model WorkspaceInvite {
  id          String            @id @default(uuid(7)) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  /// SHA-256 digest of the opaque token used in the invite URL. The raw token
  /// is never persisted; the application hashes the URL token before lookup.
  code        String            @unique
  /// NULL for a shareable link that anyone may redeem.
  email       String?           @db.Citext
  role        WorkspaceRoleType @default(MEMBER)
  status      InviteStatus      @default(PENDING)
  createdById String            @map("created_by_id") @db.Uuid

  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // "Pending invites for this workspace" — the admin screen. The leading column
  // also serves an unfiltered listing. Redemption goes through the unique
  // index on `code`.
  @@index([workspaceId, status])
  // FK index for cascade cleanup when the inviter is removed.
  @@index([createdById])
  @@map("workspace_invites")
}

// ===========================================================================
// Attachments
// ===========================================================================

/// File metadata attached to a message.
///
/// Storage-provider agnostic on purpose: `storageKey` is an opaque identifier
/// owned by whichever backend is chosen later (local disk, S3, R2), and `url`
/// caches a resolved public URL when one exists. No upload logic lives here.
model Attachment {
  id         String  @id @default(uuid(7)) @db.Uuid
  messageId  String? @map("message_id") @db.Uuid
  workspaceId String? @map("workspace_id") @db.Uuid
  channelId String? @map("channel_id") @db.Uuid
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  fileName   String  @map("file_name")
  mimeType   String  @map("mime_type")
  /// Size in bytes.
  size       Int
  storageKey String  @map("storage_key")
  url        String?
  checksum   String?
  status     AttachmentStatus @default(PENDING)
  errorMessage String? @map("error_message")
  indexedAt DateTime? @map("indexed_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  knowledgeSource KnowledgeSource?

  // "Load the attachments for these messages" — issued alongside every message
  // page fetch.
  @@index([messageId])
  @@index([workspaceId, channelId, createdAt])
  @@index([uploadedById, status, createdAt])
  @@map("attachments")
}

// ===========================================================================
// Authentication (Better Auth)
// ===========================================================================
//
// These three models mirror Better Auth 1.7.x's required schema exactly. Their
// Prisma field names deliberately match Better Auth's logical field names —
// the library resolves fields by Prisma model field, so renaming any of them
// would require a matching `fields` override in lib/auth/auth.ts. Only the
// database column names are translated to NEURA's snake_case convention.
//
// Ids are UUIDv7 like every other NEURA table: Better Auth is configured with
// `advanced.database.generateId: false`, so it omits `id` on insert and
// Prisma's `@default(uuid(7))` supplies it.

/// An authentication method belonging to a user.
///
/// For email + password there is exactly one row per user with
/// `providerId = "credential"` and the Argon2 password hash in `password`.
/// OAuth providers add further rows here without any schema change — that is
/// the whole reason credentials are a separate table rather than columns on
/// `User`.
model Account {
  id         String @id @default(uuid(7)) @db.Uuid
  /// Issuer of the account: a local marker for credentials, or the OAuth
  /// provider's issuer URL.
  issuer     String
  /// The user's identifier *at the provider*. For credentials this is the
  /// NEURA user id.
  accountId  String @map("account_id")
  providerId String @map("provider_id")
  userId     String @map("user_id") @db.Uuid

  /// Argon2id hash written by Better Auth. Never a plaintext password, and
  /// never returned by the API — Better Auth marks this field `returned: false`.
  password String?

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Required by Better Auth: one account per identity at a given issuer.
  @@unique([issuer, accountId])
  // "Every credential this user owns" — read on sign-in and on account linking.
  @@index([userId])
  @@map("accounts")
}

/// An active login. One row per device, so revoking a single session never
/// signs the user out everywhere.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Opaque 32-character token; the value held in the session cookie.
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "List / revoke this user's sessions", and the FK index that keeps the
  // cascade cheap when a user is removed.
  @@index([userId])
  // Lets expired-session cleanup scan by expiry instead of the whole table.
  @@index([expiresAt])
  @@map("sessions")
}

/// Short-lived tokens for email verification and password reset.
///
/// Unused in Phase 3 — neither flow delivers email yet — but the table is
/// required by Better Auth and creating it now means the email phase is a
/// configuration change rather than a migration.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Better Auth looks tokens up by identifier on every verification attempt.
  @@index([identifier])
  @@map("verifications")
}
