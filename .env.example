# ---------------------------------------------------------------------------
# NEURA — environment configuration
#
# Copy this file to `.env` and adjust the values for your machine:
#   cp .env.example .env
# Next.js may additionally use `.env.local`; Docker Compose reads `.env` by
# default, so keep the POSTGRES_* and REDIS_PORT values there.
#
# `.env*` files are git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# Node runtime mode: development | test | production.
# Deployment-owned: set production for a deployed release.
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL
#
# These three values are consumed by docker-compose.yml to provision the
# database container. DATABASE_URL below must stay in sync with them.
# ---------------------------------------------------------------------------
POSTGRES_USER=neura
POSTGRES_PASSWORD=neura_dev_password
POSTGRES_DB=neura
POSTGRES_PORT=5432

# Required. Connection string used by Prisma (application + CLI).
DATABASE_URL="postgresql://neura:neura_dev_password@localhost:5432/neura?schema=public"

# ---------------------------------------------------------------------------
# Required. Redis connection used for realtime, presence, notifications, and
# shared rate limits. Use rediss:// when the deployment requires TLS.
# ---------------------------------------------------------------------------
REDIS_PORT=6379

REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------

# Signs session cookies and verification tokens. REQUIRED — at least 32 chars.
# Generate one with:
#   openssl rand -base64 32
# Rotating this value invalidates every active session.
# Use a different secret per environment, and never commit the real value.
BETTER_AUTH_SECRET=

# Optional. Origin Better Auth issues cookies and callback URLs for.
# Optional: falls back to NEXT_PUBLIC_APP_URL, which is correct for a
# single-origin deployment. Set it only when the API origin differs.
# BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Application (exposed to the browser — never put secrets behind NEXT_PUBLIC_).
# NEXT_PUBLIC_APP_URL is deployment-owned and must be the public HTTPS origin in
# staging/production. Docker passes it as a build argument because it is
# embedded into the browser bundle at build time.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=NEURA
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional for physical-device testing. Keep the default loopback binding for
# local-only development; use 0.0.0.0 only on a trusted private network.
# APP_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# AI provider (server-only; never expose the API key to the browser).
# Optional: core collaboration and keyword-only knowledge remain available
# without OpenAI.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=800

# Optional. Production Compose scheduler poll interval for due daily agents.
# The minimum is 15000 milliseconds; the default is 60000.
DAILY_AGENT_POLL_INTERVAL_MS=60000

# Knowledge / RAG (server-only configuration)
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_MAX_DOCUMENT_CHARACTERS=200000
KNOWLEDGE_MAX_CHUNKS=200
KNOWLEDGE_CHUNK_SIZE=4000
KNOWLEDGE_CHUNK_OVERLAP=400
KNOWLEDGE_RETRIEVAL_LIMIT=8

# Files / rich media (private storage; never expose this directory publicly).
# Local filesystem storage is suitable for one instance. Shared private object
# storage is deployment-owned before horizontal scaling.
FILE_STORAGE_ROOT=./storage
FILE_MAX_BYTES=26214400
FILE_MAX_COUNT=10
FILE_MAX_TOTAL_BYTES=52428800

# Account email. Optional in local development: console writes private .eml
# files and never sends mail. Deployment-owned production configuration must
# use Resend with a verified sender and secret API key.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
EMAIL_DEV_INBOX_DIR=./.local-email-inbox
