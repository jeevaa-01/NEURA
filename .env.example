# ---------------------------------------------------------------------------
# NEURA — environment configuration
#
# Copy this file to `.env` and adjust the values for your machine:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# Node runtime mode: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL
#
# These three values are consumed by docker-compose.yml to provision the
# database container. DATABASE_URL below must stay in sync with them.
# ---------------------------------------------------------------------------
POSTGRES_USER=neura
POSTGRES_PASSWORD=neura_dev_password
POSTGRES_DB=neura
POSTGRES_PORT=5432

# Connection string used by Prisma (application + CLI).
DATABASE_URL="postgresql://neura:neura_dev_password@localhost:5432/neura?schema=public"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379

REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------

# Signs session cookies and verification tokens. REQUIRED — at least 32 chars.
# Generate one with:
#   openssl rand -base64 32
# Rotating this value invalidates every active session.
# Use a different secret per environment, and never commit the real value.
BETTER_AUTH_SECRET=

# Origin Better Auth issues cookies and callback URLs for.
# Optional: falls back to NEXT_PUBLIC_APP_URL, which is correct for a
# single-origin deployment. Set it only when the API origin differs.
# BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Application (exposed to the browser — never put secrets behind NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=NEURA
NEXT_PUBLIC_APP_URL=http://localhost:3000
